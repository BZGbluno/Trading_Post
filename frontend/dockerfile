# Use the official Node.js image
FROM node:20-alpine

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Install Expo ngrok support
RUN npm install -g @expo/ngrok@^4.1.0

# Copy app source
COPY . .

# Expo / Metro ports
EXPOSE 8081
EXPOSE 19000
EXPOSE 19001
EXPOSE 19002

# Start Expo
CMD ["npx", "expo", "start", "--lan", "--clear"]